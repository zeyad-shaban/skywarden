<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
    <!-- SPECS -->
    <xacro:property name="base_lx" value="0.3" />
    <xacro:property name="base_ly" value="0.3" />
    <xacro:property name="base_lz" value="0.05" />
    <xacro:property name="base_mass" value="0.8" />

    <xacro:property name="yaw_lx" value="0.2" />
    <xacro:property name="yaw_ly" value="0.2" />
    <xacro:property name="yaw_lz" value="0.05" />
    <xacro:property name="yaw_mass" value="0.2" />

    <xacro:property name="stand_lx" value="0.05" />
    <xacro:property name="stand_ly" value="0.02" />
    <xacro:property name="stand_lz" value="0.15" />
    <xacro:property name="stand_mass" value="0.1" />

    <xacro:property name="pitch_lx" value="0.02" />
    <xacro:property name="pitch_ly" value="0.15" />
    <xacro:property name="pitch_lz" value="0.13" />
    <xacro:property name="pitch_mass" value="0.1" />

    <xacro:property name="muzzle_lx" value="0.07" />
    <xacro:property name="muzzle_ly" value="0.05" />
    <xacro:property name="muzzle_lz" value="0.05" />
    <xacro:property name="muzzle_mass" value="0.02" />

    <xacro:property name="camera_lx" value="0.02" />
    <xacro:property name="camera_ly" value="0.04" />
    <xacro:property name="camera_lz" value="0.04" />
    <!-- END_SPECS -->


    <link name="footprint" />

    <link name="base_link">

        <visual>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <geometry>
                <box size="${base_lx} ${base_ly} ${base_lz}" />
            </geometry>
            <material name="red" />
        </visual>

        <collision>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <geometry>
                <box size="${base_lx} ${base_ly} ${base_lz}" />
            </geometry>
        </collision>

        <xacro:box_inertial m="${base_mass}" lx="${base_lx}" ly="${base_ly}" lz="${base_lz}"
            o_xyz="0 0 0" o_rpy="0 0 0" />

    </link>

    <joint name="base_footprint_joint" type="fixed">
        <origin xyz="0 0 ${base_lz / 2}" rpy="0 0 0" />
        <parent link="footprint" />
        <child link="base_link" />
    </joint>

    <link name="yaw_link">

        <visual>
            <origin xyz="0 0 ${yaw_lz / 2}" rpy="0 0 0" />
            <geometry>
                <box size="${yaw_lx} ${yaw_ly} ${yaw_lz}" />
            </geometry>
            <material name="green" />
        </visual>

        <collision>
            <origin xyz="0 0 ${yaw_lz / 2}" rpy="0 0 0" />
            <geometry>
                <box size="${yaw_lx} ${yaw_ly} ${yaw_lz}" />
            </geometry>
        </collision>

        <xacro:box_inertial m="${yaw_mass}" lx="${yaw_lx}" ly="${yaw_ly}" lz="${yaw_lz}"
            o_xyz="0 0 ${yaw_lz / 2}" o_rpy="0 0 0" />

    </link>

    <joint name="yaw_base_joint" type="revolute">
        <origin xyz="0 0 ${base_lz / 2}" rpy="0 0 0" />
        <parent link="base_link" />
        <child link="yaw_link" />
        <axis xyz="0 0 1" />
        <limit lower="${-pi/2}" upper="${pi/2}" effort="30" velocity="${pi}" /> <!-- Nema 17 motor
        have holding toruqe of 0.3 N*m-->
    </joint>

    <!-- Stand -->
    <link name="lstand_link">

        <visual>
            <origin xyz="0 0 ${stand_lz / 2}" rpy="0 0 0" />
            <geometry>
                <box size="${stand_lx} ${stand_ly} ${stand_lz}" />
            </geometry>
            <material name="black" />
        </visual>

        <collision>
            <origin xyz="0 0 ${stand_lz / 2}" rpy="0 0 0" />
            <geometry>
                <box size="${stand_lx} ${stand_ly} ${stand_lz}" />
            </geometry>
        </collision>

        <xacro:box_inertial m="${stand_mass}" lx="${stand_lx}" ly="${stand_ly}" lz="${stand_lz}"
            o_xyz="0 0 ${stand_lz / 2}" o_rpy="0 0 0" />

    </link>

    <joint name="lstand_yaw_joint" type="fixed">
        <origin xyz="0 ${(pitch_ly + stand_ly) / 2} ${yaw_lz}" rpy="0 0 0" />
        <parent link="yaw_link" />
        <child link="lstand_link" />
    </joint>

    <link name="rstand_link">

        <visual>
            <origin xyz="0 0 ${stand_lz / 2}" rpy="0 0 0" />
            <geometry>
                <box size="${stand_lx} ${stand_ly} ${stand_lz}" />
            </geometry>
            <material name="black" />
        </visual>

        <collision>
            <origin xyz="0 0 ${stand_lz / 2}" rpy="0 0 0" />
            <geometry>
                <box size="${stand_lx} ${stand_ly} ${stand_lz}" />
            </geometry>
        </collision>

        <xacro:box_inertial m="${stand_mass}" lx="${stand_lx}" ly="${stand_ly}" lz="${stand_lz}"
            o_xyz="0 0 ${stand_lz / 2}" o_rpy="0 0 0" />
    </link>

    <joint name="rstand_yaw_joint" type="fixed">
        <origin xyz="0 -${(pitch_ly + stand_ly) / 2} ${yaw_lz}" rpy="0 0 0" />
        <parent link="yaw_link" />
        <child link="rstand_link" />
    </joint>

    <link name="pitch_link">

        <visual>
            <origin xyz="0 0 0.02" rpy="0 0 0" />
            <geometry>
                <box size="${pitch_lx} ${pitch_ly} ${pitch_lz}" />
            </geometry>
            <material name="blue" />
        </visual>

        <collision>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <geometry>
                <box size="${pitch_lx} ${pitch_ly} ${pitch_lz}" />
            </geometry>
        </collision>

        <xacro:box_inertial m="${pitch_mass}" lx="${pitch_lx}" ly="${pitch_ly}" lz="${pitch_lz}"
            o_xyz="0 0 0" o_rpy="0 0 0" />
    </link>

    <joint name="pitch_base_joint" type="revolute">
        <origin xyz="0 -${pitch_ly / 2 + stand_ly / 2} ${pitch_lz / 2 + stand_lz * 0.8}" rpy="0 0 0" />
        <parent link="lstand_link" />
        <child link="pitch_link" />
        <axis xyz="0 1 0" />
        <limit lower="${-pi/2}" upper="${pi/2}" effort="30" velocity="${pi}" /> <!-- Nema 17 motor
        have holding toruqe of 0.3 N*m-->
    </joint>

    <link name="muzzle_link">

        <visual>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <geometry>
                <box size="${muzzle_lx} ${muzzle_ly} ${muzzle_lz}" />
            </geometry>
            <material name="white" />
        </visual>

    </link>
    
    <joint name="muzzle_pitch_joint" type="fixed">
        <origin xyz="${(pitch_lx + muzzle_lx) / 2} 0 0" rpy="0 0 0"/>
        <parent link="pitch_link"/>
        <child link="muzzle_link"/>
    </joint>

    <!-- Camera -->
    <link name="camera_link">
        
        <visual>
            <origin xyz="0.0 0 0" rpy="0 0 0"/>
            <geometry>
                <box size="${camera_lx} ${camera_ly} ${camera_lz}"/>
            </geometry>
            <material name="black" />
        </visual>

    </link>

    <joint name="camera_pitch_link" type="fixed">
        <origin xyz="${(pitch_lx + camera_lx) / 2} 0 ${pitch_lz - camera_lz * 1.7}" rpy="0 0 0" />
        <parent link="pitch_link" />
        <child link="camera_link" />
    </joint>
    
</robot>